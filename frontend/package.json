{
  "name": "movies-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generateTypes": "openapi-typescript ../backend/src/main/resources/openapi/openapi.yaml -o src/api/schema.d.ts",
    "postinstall": "npm run generateTypes",
    "predev": "npm run generateTypes",
    "dev": "vite",
    "prebuild": "npm run generateTypes",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
